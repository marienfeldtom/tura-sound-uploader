{
  "apps": [
    {
      "name": "sound-uploader",
      "script": "dist/main.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "300M",
      "min_uptime": "5s",
      "max_restarts": 10,
      "restart_delay": 2000,
      "exp_backoff_restart_delay": 100,
      "error_file": "logs/pm2-error.log",
      "out_file": "logs/pm2-out.log",
      "time": true,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}